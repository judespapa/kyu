{
  "name": "kyu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "kyu — create and share creative vacation albums with family",
  "scripts": {
    "dev": "concurrently -k -n server,client -c teal,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm run build && node server/index.js",
    "preview": "node server/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/judespapa/kyu.git"
  },
  "license": "ISC",
  "dependencies": {
    "concurrently": "^9.2.4",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/uuid": "^10.0.0"
  }
}
